-- BUCLE DE FPS Y PING REAL (MEDICIÓN PRECISA Y ESTABLE)
-- ───────────────────────────────────────────────────────────────── 
task.spawn(function()
    local frameCount = 0
    local lastUpdate = os.clock()

    RunService.RenderStepped:Connect(function()
        frameCount = frameCount + 1
        local now = os.clock()
        local elapsed = now - lastUpdate

        -- Actualiza cada 0.8 segundos (ritmo fluido y natural sin cambios bruscos)
        if elapsed >= 0.8 then
            -- 1. FPS PROMEDIO REAL
            local currentFps = math.round(frameCount / elapsed)
            frameCount = 0
            lastUpdate = now

            -- 2. PING REAL DE RED
            local currentPing = 0
            pcall(function()
                currentPing = math.round(player:GetNetworkPing() * 1000)
            end)

            if currentPing == 0 then
                pcall(function()
                    currentPing = math.round(Stats.PerformanceStats.Ping:GetValue())
                end)
            end

            if infoLabelRef then
                infoLabelRef.Text = string.format("%dfps|%dms", currentFps, currentPing)
            end
        end
    end)
end)

