-- Búsqueda segura del remoto de notificaciones (Sin activar honeypots)
local function resolveNotifyRemote()
    if not Net then return nil end
    local ok, api = pcall(require, Net)
    if ok and type(api) == "table" then
        -- Buscar específicamente el remoto seguro de notificaciones
        for _, obj in ipairs(Net:GetChildren()) do
            if obj:IsA("RemoteEvent") and (obj.Name:lower():find("notify") or obj.Name:lower():find("announc")) then
                return obj
            end
        end
    end
    -- Fallback silencioso en ReplicatedStorage
    return ReplicatedStorage:FindFirstChild("NotificationRemote", true) or ReplicatedStorage:FindFirstChild("AnnouncementRemote", true)
end

