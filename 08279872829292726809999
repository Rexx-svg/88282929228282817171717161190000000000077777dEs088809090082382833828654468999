-- // [6] FUNCTIONALITY & EVENTS //
local function setupDragging()
    local dragging, dragInput, dragStart, startPos
    local threshold = UserInputService.TouchEnabled and 10 or 3

    MainBar.InputBegan:Connect(function(input)
        if _isLocked then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        if dragging then return end
        dragging = true
        dragInput = input
        dragStart = Vector2.new(input.Position.X, input.Position.Y)
        startPos = MainBar.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End or input.UserInputState == Enum.UserInputState.Cancel then
                dragging = false
                dragInput = nil
            end
        end)
    end)

    UserInputService.InputChanged:Connect(function(input)
        if _isLocked or not dragging or not dragInput then return end
        local ok = (dragInput.UserInputType == Enum.UserInputType.Touch and input == dragInput) or (dragInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement)
        if not ok then return end

        local delta = Vector2.new(input.Position.X, input.Position.Y) - dragStart
        if delta.Magnitude < threshold then return end

        MainBar.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end)
end

local function setupChatCommands()
    local function processChat(msg)
        local cleanMsg = normalizeCode(msg)
        local lowerMsg = string.lower(cleanMsg)

        if lowerMsg == "/hide" then
            if ScreenGui then ScreenGui.Enabled = false end
        elseif lowerMsg == "/show" then
            if ScreenGui then ScreenGui.Enabled = true end
        end
    end

    if LocalPlayer.Chatted then
        chatConn = LocalPlayer.Chatted:Connect(processChat)
    end
end

local function setupEvents()
    -- TOGGLE SCAN
    ScanButton.MouseButton1Click:Connect(function()
        _enabled = not _enabled
        updateStatusVisual()
        updateScanButton()
        if not _enabled then
            _msgBuffer = {}
            _msgCombined = ""
            if PreviewBox then PreviewBox.Text = "" end
            updateCounterDisplay()
        end
    end)

    -- BOTÓN CONTADOR (+1 HASTA 10)
    CounterBtn.MouseButton1Click:Connect(function()
        if _targetCount >= _maxCount then
            _targetCount = 1
        else
            _targetCount = _targetCount + 1
        end
        _msgBuffer = {}
        _msgCombined = ""
        if PreviewBox then PreviewBox.Text = "" end
        updateCounterDisplay()
    end)

    -- CANDADO LOCK/UNLOCK
    LockButton.MouseButton1Click:Connect(function()
        _isLocked = not _isLocked
        updateLockButton()
    end)

    -- Conexión segura de Notificaciones
    local notifyRemote = resolveNotifyRemote()
    if notifyRemote then
        listenConn = notifyRemote.OnClientEvent:Connect(function(...)
            if not _enabled or not isAnnouncement(...) then return end
            pcall(onAnnouncement, ...)
        end)
    end
end

