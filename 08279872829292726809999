    const isBrowser = /mozilla|chrome|safari|firefox|edge|opera/i.test(userAgent);

    if (isBrowser) {
      return new Response('404 Not Found', {
        status: 404,
        headers: { 
          'Content-Type': 'text/plain; charset=utf-8' 
        },
      });
    }

