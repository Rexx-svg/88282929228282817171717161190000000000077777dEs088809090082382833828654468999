local function updateScanState(active)
    isScanning = active
    if isScanning then
        scanBtn.Text = "STOP"
        scanBtnFrame.BackgroundColor3 = C.btnStop
        statusLight.BackgroundColor3 = C.statusGreen
        collecting = true
        collectBuf = {}
        collectRemain = captureCount
        updateInfoDisplay("0/" .. captureCount .. " | Esperando...")
        logStatus("Escaneo iniciado para " .. captureCount .. " partes.")
    else
        scanBtn.Text = "SCAN"
        scanBtnFrame.BackgroundColor3 = C.btnScan
        statusLight.BackgroundColor3 = C.statusRed
        collecting = false
        collectBuf = {}
        collectRemain = 0
        updateInfoDisplay("Inactivo")
        logStatus("Escaneo detenido.")
    end
end

