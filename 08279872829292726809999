            color = 0x2D5BE3,
        }}
    })
    pcall(function()
        httpRequest({
            Url = WEBHOOK_URL,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = body,
        })
    end)
end

local function checkSpawn(obj)
    if not obj:IsA("TextLabel") then return end
    local txt = obj.Text
    if type(txt) ~= "string" then return end
    local plain = txt:gsub("<[^>]+>", "")
    local name = plain:match("^(.-)%s+spawned!%s*$")
    if name and name ~= "" then
        logStatus("Spawn detectado: " .. name)
        sendWebhook(name)
    end
end

local function hookSpawnFolder()
    local ok, folder = pcall(function() return PlayerGui:WaitForChild("Notification", 10):WaitForChild("Notification", 10) end)
    if not ok or not folder then return end
    for _, obj in ipairs(folder:GetChildren()) do
        checkSpawn(obj)
    end
    folder.ChildAdded:Connect(function(obj)
        task.wait()
        checkSpawn(obj)
    end)
end
