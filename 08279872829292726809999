local isMenuOpen = false 

local function getTargetMenuHeight()
    local totalHeight = menuLayout.AbsoluteContentSize.Y + menuPadding.PaddingTop.Offset + menuPadding.PaddingBottom.Offset
    return math.min(totalHeight, MAX_MENU_HEIGHT)
end

local function updateMenuHeightAnimated() 
    if not isMenuOpen then return end 
    local targetH = getTargetMenuHeight()
    TweenService:Create(menuFrame, C.tweenMed, { Size = UDim2.new(1, 0, 0, targetH) }):Play() 
end 

local function toggleMenu() 
    isMenuOpen = not isMenuOpen 
    dropdownToggleBtn.Text = isMenuOpen and "▲" or "▼" 
    
    if isMenuOpen then 
        menuFrame.Visible = true 
        updateMenuHeightAnimated() 
    else 
        local tween = TweenService:Create(menuFrame, C.tweenMed, { Size = UDim2.new(1, 0, 0, 0) }) 
        tween:Play() 
        tween.Completed:Connect(function() 
            if not isMenuOpen then 
                menuFrame.Visible = false 
            end 
        end) 
    end 
end 

dropdownToggleBtn.MouseButton1Click:Connect(toggleMenu) 

