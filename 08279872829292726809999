-- // [4] UTILITY FUNCTIONS //
local function normalizeCode(s)
    if type(s) ~= "string" then return "" end
    return s:match("^%s*(.-)%s*$") or ""
end

local function stripRich(t)
    if type(t) ~= "string" then return tostring(t) end
    return (t:gsub("<[^>]->", ""))
end

local function getGameCodesUI()
    local gui = PlayerGui:FindFirstChild("Codes") or PlayerGui:FindFirstChild("CodesGui", true)
    if not gui then return nil end
    
    for _, obj in ipairs(gui:GetDescendants()) do
        if obj:IsA("TextBox") then
            return obj
        end
    end
    return nil
end

local function resolveRedeemRemote()
    if RedeemRemote and RedeemRemote.Parent then return RedeemRemote end
    if not Net then return nil end
    local ok, api = pcall(require, Net)
    if ok and type(api) == "table" then
        local rok, rf = pcall(function() return api:RemoteFunction(REDEEM_GUID) end)
        if rok and typeof(rf) == "Instance" then RedeemRemote = rf end
    end
    return RedeemRemote
end

-- Canjeo 100% seguro por servidor (sin simular clicks ni firesignal trampa)
local function aceRedeem(code)
    code = normalizeCode(code)
    if code == "" then return end

    -- Mostrar visualmente en la caja del juego por comodidad
    local box = getGameCodesUI()
    if box then
        pcall(function()
            box.Text = code
        end)
    end

    -- Invocación limpia directamente al servidor
    task.spawn(function()
        task.wait(math.random(10, 25) / 100) -- Delay humano imperceptible
        local rf = resolveRedeemRemote()
        if rf then
            pcall(function() rf:InvokeServer(code) end)
        end
    end)

    task.delay(0.5, function()
        if box then
            pcall(function() box.Text = "" end)
        end
    end)
end

local function updateCounterDisplay()
    if CounterBtn then
        local current = #_msgBuffer
        CounterBtn.Text = string.format("%d/%d  +", current, _targetCount)
    end
end

local function appendToBox(rawText)
    if not rawText or rawText == "" or not _enabled then return end

    local cleanCode = rawText:match("[%w_%-]+") or rawText

    table.insert(_msgBuffer, cleanCode)
    _msgCombined = table.concat(_msgBuffer)
    
    if PreviewBox then 
        PreviewBox.Text = _msgCombined 
    end
    
    updateCounterDisplay()

    if #_msgBuffer >= _targetCount then
        local finalCode = _msgCombined
        aceRedeem(finalCode)
        
        _msgBuffer = {}
        _msgCombined = ""
        task.delay(0.5, function()
            if PreviewBox then PreviewBox.Text = "" end
            updateCounterDisplay()
        end)
    end
end

local ACE_POS = {
    Top = true, Bottom = true, Center = true, Middle = true,
    Left = true, Right = true, TopRight = true, TopLeft = true,
    BottomRight = true, BottomLeft = true,
}

local function isAnnouncement(...)
    local args = table.pack(...)
    if args.n == 0 then return false end
    for i = 1, args.n do
        local v = args[i]
        if typeof(v) == "string" and #v > 0 and not v:find("Sounds%.") and not v:find("rbxassetid") then 
            return true 
        end
    end
    return false
end

local function onAnnouncement(...)
    local args = table.pack(...)
    local rawText = ""
    
    for i = 1, args.n do
        local v = args[i]
        if type(v) == "string" and not v:find("Sounds%.") and not v:find("rbxassetid") and not ACE_POS[v] then
            if #v > #rawText then
                rawText = v
            end
        end
    end

    local text = stripRich(rawText):match("^%s*(.-)%s*$") or ""
    if text == "" then return end
    
    if _seenMsgs[text] then return end
    _seenMsgs[text] = true
    task.delay(0.2, function() _seenMsgs[text] = nil end)
    
    appendToBox(text)
end

